<?xml version="1.0" encoding="utf-8"?>
<Configuration>
  <CodeCoverage>
    <!-- Рахуємо тільки наші збірки, без NuGet-бібліотек і самих тестів -->
    <ModulePaths>
      <Include>
        <ModulePath>.*MovieTracker\..*\.dll$</ModulePath>
      </Include>
      <Exclude>
        <ModulePath>.*MovieTracker\.Tests\.dll$</ModulePath>
      </Exclude>
    </ModulePaths>

    <Sources>
      <Exclude>
        <Source>.*[\\/]Migrations[\\/].*</Source>
        <Source>.*[\\/]obj[\\/].*</Source>
        <Source>.*[\\/]Program\.cs$</Source>
      </Exclude>
    </Sources>

    <Attributes>
      <Exclude>
        <Attribute>^System\.Diagnostics\.CodeAnalysis\.ExcludeFromCodeCoverageAttribute$</Attribute>
        <Attribute>^System\.CodeDom\.Compiler\.GeneratedCodeAttribute$</Attribute>
      </Exclude>
    </Attributes>
  </CodeCoverage>
</Configuration>