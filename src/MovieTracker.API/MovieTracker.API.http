### 48. create public collection (201)
# @name createCollection
POST {{host}}/api/collections
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "Мої улюблені", "description": "Тестова колекція", "isPublic": true }

### 49. create collection with empty name (400)
POST {{host}}/api/collections
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "", "description": null, "isPublic": true }

### 50. create collection without token (401)
POST {{host}}/api/collections
Content-Type: application/json

{ "name": "x", "description": null, "isPublic": true }

### 51. create private collection (201)
# @name createPrivate
POST {{host}}/api/collections
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "Секретна", "description": null, "isPublic": false }

### 52. my collections, public and private (200)
GET {{host}}/api/collections/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### 53. add movie to collection (204)
POST {{host}}/api/collections/{{createCollection.response.body.$.id}}/movies/155
Authorization: Bearer {{login.response.body.$.accessToken}}

### 54. add same movie again (204, no duplicate)
POST {{host}}/api/collections/{{createCollection.response.body.$.id}}/movies/155
Authorization: Bearer {{login.response.body.$.accessToken}}

### 55. add movie not found in TMDB (404)
POST {{host}}/api/collections/{{createCollection.response.body.$.id}}/movies/99999999
Authorization: Bearer {{login.response.body.$.accessToken}}

### 56. get public collection without token (200)
GET {{host}}/api/collections/{{createCollection.response.body.$.id}}

### 57. get private collection without token (404)
GET {{host}}/api/collections/{{createPrivate.response.body.$.id}}

### 58. get private collection as owner (200)
GET {{host}}/api/collections/{{createPrivate.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### 59. update collection (200)
PUT {{host}}/api/collections/{{createCollection.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "name": "Нова назва", "description": "Новий опис", "isPublic": true }

### 60. public collections of a user, only public (200)
GET {{host}}/api/users/{{createCollection.response.body.$.userId}}/collections

### 61. remove movie from collection (204)
DELETE {{host}}/api/collections/{{createCollection.response.body.$.id}}/movies/155
Authorization: Bearer {{login.response.body.$.accessToken}}

### 62. remove movie again (404)
DELETE {{host}}/api/collections/{{createCollection.response.body.$.id}}/movies/155
Authorization: Bearer {{login.response.body.$.accessToken}}

### 63. delete collection (204)
DELETE {{host}}/api/collections/{{createCollection.response.body.$.id}}
Authorization: Bearer {{login.response.body.$.accessToken}}

### 64. get deleted collection (404)
GET {{host}}/api/collections/{{createCollection.response.body.$.id}}

### 65. get public user profile (200)
GET {{host}}/api/users/{{login.response.body.$.user.id}}

### 66. get public user profile not found (404)
GET {{host}}/api/users/00000000-0000-0000-0000-000000000000

### 67. get user reviews (200)
GET {{host}}/api/users/{{login.response.body.$.user.id}}/reviews?page=1&pageSize=10

### 68. get user taste profile (200 or 404 if not analyzed)
GET {{host}}/api/users/{{login.response.body.$.user.id}}/taste-profile

### 65. follows: register A (200, or 400 if it already exists)
# @name regA
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "follow-a@example.com", "password": "Test1234", "displayName": "Follow A" }

### 66. follows: register B (200, or 400 if it already exists)
# @name regB
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "follow-b@example.com", "password": "Test1234", "displayName": "Follow B" }

### 67. follows: login A (200)
# @name loginA
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "follow-a@example.com", "password": "Test1234" }

### 68. follows: login B (200)
# @name loginB
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "follow-b@example.com", "password": "Test1234" }

### 69. follows: profile A, here we take A's id (200)
# @name meA
GET {{host}}/api/users/me
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 70. follows: profile B, here we take B's id (200)
# @name meB
GET {{host}}/api/users/me
Authorization: Bearer {{loginB.response.body.$.accessToken}}

### 71. A follows B (204)
POST {{host}}/api/users/{{meB.response.body.$.id}}/follow
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 72. A follows B again (204, no error)
POST {{host}}/api/users/{{meB.response.body.$.id}}/follow
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 73. B stats as A (200, followersCount 1, isFollowedByMe true)
GET {{host}}/api/users/{{meB.response.body.$.id}}/follow-stats
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 74. B followers (200, list contains A)
GET {{host}}/api/users/{{meB.response.body.$.id}}/followers

### 75. A following (200, list contains B)
GET {{host}}/api/users/{{meA.response.body.$.id}}/following

### 76. follow yourself (400)
POST {{host}}/api/users/{{meA.response.body.$.id}}/follow
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 77. follow without token (401)
POST {{host}}/api/users/{{meB.response.body.$.id}}/follow

### 78. follow non-existent user (404)
POST {{host}}/api/users/00000000-0000-0000-0000-000000000001/follow
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 79. A unfollows B (204)
DELETE {{host}}/api/users/{{meB.response.body.$.id}}/follow
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 80. unfollow again (404)
DELETE {{host}}/api/users/{{meB.response.body.$.id}}/follow
Authorization: Bearer {{loginA.response.body.$.accessToken}}

### 81. B stats after unfollow (200, followersCount 0, isFollowedByMe false)
GET {{host}}/api/users/{{meB.response.body.$.id}}/follow-stats
Authorization: Bearer {{loginA.response.body.$.accessToken}}


