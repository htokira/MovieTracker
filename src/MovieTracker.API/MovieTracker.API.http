@MovieTracker.API_HostAddress = http://localhost:7226
@host = http://localhost:7226
@email = test@example.com
@password = Test1234

### 1. registration (200)
# @name register
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "displayName": "Test User" }

### 2. same email registration (400)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}", "displayName": "Test User" }

### 3. weak password (400)
POST {{host}}/api/auth/register
Content-Type: application/json

{ "email": "weak@example.com", "password": "abc", "displayName": "Weak" }

### 4.wrong password (401)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "WrongPass1" }

### 5. correct password login (200)
# @name login
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### 6. profile no token (401)
GET {{host}}/api/users/me

### 7. profile with token (200)
GET {{host}}/api/users/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### 8. update user (200)
PUT {{host}}/api/users/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "displayName": "New Name", "avatarUrl": null, "bio": "Hello" }

### 9. wrong name (400)
PUT {{host}}/api/users/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "displayName": "a", "avatarUrl": null, "bio": null }

### 10. refresh token (200)
# @name refresh1
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{login.response.body.$.refreshToken}}" }

### 11. old refresh token again (401)
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{login.response.body.$.refreshToken}}" }

### 12. login again
# @name login2
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

### 13. logout (204)
POST {{host}}/api/auth/logout
Content-Type: application/json

{ "refreshToken": "{{login2.response.body.$.refreshToken}}" }

### 14. refresh after logout (401)
POST {{host}}/api/auth/refresh
Content-Type: application/json

{ "refreshToken": "{{login2.response.body.$.refreshToken}}" }

### 15. login then change password
# @name login3
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

###
POST {{host}}/api/users/me/change-password
Authorization: Bearer {{login3.response.body.$.accessToken}}
Content-Type: application/json

{ "currentPassword": "{{password}}", "newPassword": "NewPass1234" }

### 16. old password (401), new password (200)
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "{{password}}" }

###
# @name login4
POST {{host}}/api/auth/login
Content-Type: application/json

{ "email": "{{email}}", "password": "NewPass1234" }

### 17. delete user (204)
DELETE {{host}}/api/users/me
Authorization: Bearer {{login4.response.body.$.accessToken}}

### 18. after deleting (401)
GET {{host}}/api/users/me
Authorization: Bearer {{login4.response.body.$.accessToken}}

### 19. add or update a review (200)
PUT {{host}}/api/movies/603/reviews/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "rating": 9, "text": "good i guess" }

### 20. review and avg (200)
GET {{host}}/api/movies/603/reviews?page=1&pageSize=10

### 21. my review (200)
GET {{host}}/api/movies/603/reviews/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### 22. delete review (204)
DELETE {{host}}/api/movies/603/reviews/me
Authorization: Bearer {{login.response.body.$.accessToken}}

### 23. get popular movies (200)
GET {{host}}/api/movies/popular
Content-Type: application/json

### 24. get discover movies / all movies (200)
GET {{host}}/api/movies
Content-Type: application/json

### 25. get movies filtered by genre (Документальний, id = 99) (200)
GET {{host}}/api/movies?genreId=99&page=1
Content-Type: application/json

### 26. get movies sorted by release date descending (200)
GET {{host}}/api/movies?sortBy=primary_release_date.desc&page=1
Content-Type: application/json

### 27. search movies (200)
GET {{host}}/api/movies?query=інтерстеллар&page=1
Content-Type: application/json

### 28. search movies with genre filter (200)
GET {{host}}/api/movies?query=марсіанин&genreId=12&page=1
Content-Type: application/json

### 29. get movie by id (200)
GET {{host}}/api/movies/550
Content-Type: application/json

### 30. set watch status - Planned (200)
PUT {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "Planned" }

### 31. change watch status - Watched (200)
PUT {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "Watched" }

### 32. get watch status (200)
GET {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}

### 33. get my movies (200)
GET {{host}}/api/users/me/movies
Authorization: Bearer {{login.response.body.$.accessToken}}

### 34. get my movies filtered by status (200)
GET {{host}}/api/users/me/movies?status=Watched
Authorization: Bearer {{login.response.body.$.accessToken}}

### 35. get my movies with pagination (200)
GET {{host}}/api/users/me/movies?status=Planned&page=1&pageSize=20
Authorization: Bearer {{login.response.body.$.accessToken}}

### 36. set invalid watch status (400)
PUT {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "Unknown" }

### 37. set watch status for movie not found in TMDB (404)
PUT {{host}}/api/movies/99999999/status
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{ "status": "Watched" }

### 38. get my movies with invalid query (400)
GET {{host}}/api/users/me/movies?status=abc
Authorization: Bearer {{login.response.body.$.accessToken}}

### 39. get watch status without token (401)
GET {{host}}/api/movies/550/status

### 40. delete watch status (204)
DELETE {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}

### 41. delete watch status again (404)
DELETE {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}

### 42. get watch status after delete (404)
GET {{host}}/api/movies/550/status
Authorization: Bearer {{login.response.body.$.accessToken}}

### 43. Get my taste profile (404 if not analyzed yet, or 200 with profile)
GET {{host}}/api/taste-profile/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

### 44. Trigger taste profile analysis (200)
POST {{host}}/api/taste-profile/analyze
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

### 45. Reccomendations no token (401)
GET {{host}}/api/recommendations/me
Accept: application/json

### 46. Reccomendations new account (isPersonalized: false)
GET {{host}}/api/recommendations/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Accept: application/json

### Personalize test account
PUT {{host}}/api/movies/27205/reviews/me
Authorization: Bearer {{login.response.body.$.accessToken}}
Content-Type: application/json

{
  "rating": 10,
  "text": "nice brah"
}

