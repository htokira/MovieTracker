{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Data Source=movietracker.db"
  },
  "Tmdb": {
    "BaseUrl": "https://api.themoviedb.org/3/"
  },
  "Jwt": {
    "Issuer": "MovieTrackerApi",
    "Audience": "MovieTrackerClient",
    "ExpiryMinutes": "60",
    "RefreshTokenExpiryDays": "7"
  }
}