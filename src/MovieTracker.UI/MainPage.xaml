<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:MovieTracker.UI.ViewModels"
             xmlns:models="clr-namespace:MovieTracker.Core.Models;assembly=MovieTracker.Core"
             x:Class="MovieTracker.UI.MainPage"
             Title="Каталог фільмів">

    <Grid RowDefinitions="Auto, *" Padding="15">
        
        <!-- Пошук -->
        <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,15">
            <Entry Text="{Binding SearchQuery}" 
                   Placeholder="Пошук фільмів..." 
                   WidthRequest="250" />
            <Button Text="Знайти" 
                    Command="{Binding SearchCommand}" />
        </HorizontalStackLayout>

        <!-- Список фільмів -->
        <CollectionView Grid.Row="1" ItemsSource="{Binding Movies}">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Movie">
                    <Border HeightRequest="120" Margin="0,5" Padding="10">
                        <Grid ColumnDefinitions="80, *">
                            <Image Grid.Column="0" Source="{Binding PosterUrl}" Aspect="AspectFill" />
                            <VerticalStackLayout Grid.Column="1" Margin="10,0,0,0" Spacing="4">
                                <Label Text="{Binding Title}" FontAttributes="Bold" FontSize="16" />
                                <Label Text="{Binding ReleaseYear}" TextColor="Gray" FontSize="12" />
                                <Label Text="{Binding Rating, StringFormat='Рейтинг: {0:F1}'}" FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Індикатор завантаження -->
        <ActivityIndicator Grid.Row="1" 
                           IsRunning="{Binding IsLoading}" 
                           IsVisible="{Binding IsLoading}" 
                           HorizontalOptions="Center" 
                           VerticalOptions="Center" />
    </Grid>
</ContentPage>