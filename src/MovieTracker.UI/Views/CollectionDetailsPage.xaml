<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieTracker.UI.Views.CollectionDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MovieTracker.UI.ViewModels"
    xmlns:models="clr-namespace:MovieTracker.UI.Models"
    x:DataType="vm:CollectionDetailsViewModel"
    Title="Колекція"
    BackgroundColor="#171923"
    Shell.BackgroundColor="#202331"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    SizeChanged="OnPageSizeChanged">

    <Grid
        x:Name="Root"
        RowDefinitions="Auto,Auto,Auto,Auto,*,Auto"
        RowSpacing="12"
        Padding="0,20,0,20"
        HorizontalOptions="Center">

        <Label
            Grid.Row="0"
            Text="← Назад"
            TextColor="#A0A5B5"
            FontSize="16"
            FontAttributes="Bold"
            HorizontalOptions="Start">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
            </Label.GestureRecognizers>
        </Label>

        <Border
            Grid.Row="1"
            BackgroundColor="#202331"
            StrokeThickness="0"
            StrokeShape="RoundRectangle 16"
            Padding="20">
            <VerticalStackLayout Spacing="6">
                <Label
                    Text="{Binding Name}"
                    TextColor="White"
                    FontSize="20"
                    FontAttributes="Bold" />
                <Label
                    Text="{Binding PrivacyText}"
                    TextColor="#B8B1FF"
                    FontSize="12" />
                <Label
                    Text="{Binding Description}"
                    IsVisible="{Binding HasDescription}"
                    TextColor="#C5C8D3"
                    FontSize="14" />
            </VerticalStackLayout>
        </Border>

        <VerticalStackLayout Grid.Row="2">
            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                HorizontalOptions="Center" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#8B7CFF" />
        </VerticalStackLayout>

        <Label
            Grid.Row="3"
            Text="У колекції поки немає фільмів. Додайте їх з картки фільму."
            IsVisible="{Binding IsEmpty}"
            TextColor="#A0A5B5"
            FontSize="14"
            HorizontalTextAlignment="Center"
            HorizontalOptions="Center" />

        <CollectionView
            Grid.Row="4"
            ItemsSource="{Binding Movies}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:CollectionMovieItem">
                    <Border
                        BackgroundColor="#202331"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">

                        <Grid ColumnDefinitions="56,*,Auto" ColumnSpacing="12">

                            <Border
                                Grid.Column="0"
                                WidthRequest="56"
                                HeightRequest="80"
                                BackgroundColor="#292E3D"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Label
                                        Text="🎬"
                                        FontSize="22"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                    <Image Source="{Binding PosterUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Title}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />
                                <Label
                                    Text="{Binding InfoText}"
                                    TextColor="#A0A5B5"
                                    FontSize="13" />
                            </VerticalStackLayout>

                            <Button
                                Grid.Column="2"
                                Text="Прибрати"
                                Style="{StaticResource DangerButton}"
                                HeightRequest="34"
                                Padding="12,0"
                                FontSize="12"
                                VerticalOptions="Center"
                                Clicked="OnRemoveClicked" />

                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Tapped="OnMovieTapped" />
                            </Grid.GestureRecognizers>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button
            Grid.Row="5"
            Text="Видалити колекцію"
            Style="{StaticResource DangerButton}"
            Command="{Binding DeleteCollectionCommand}"
            IsEnabled="{Binding IsNotBusy}" />
    </Grid>
</ContentPage>