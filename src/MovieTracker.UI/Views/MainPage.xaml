<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Name="MainPageRoot"
    x:Class="MovieTracker.UI.Views.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:MovieTracker.Core.Dtos;assembly=MovieTracker.Core"
    xmlns:vm="clr-namespace:MovieTracker.UI.ViewModels"
    BackgroundColor="#171923"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, *">

        <!-- Верхня панель -->
        <Grid
            Grid.Row="0"
            Padding="20,15"
            ColumnDefinitions="*,Auto"
            BackgroundColor="#202331">

            <Label
                Text="Movie Tracker"
                FontSize="24"
                FontAttributes="Bold"
                TextColor="White"
                VerticalOptions="Center" />

            <Grid
                x:Name="AccountBar"
                x:DataType="vm:AccountBarViewModel"
                Grid.Column="1"
                VerticalOptions="Center">

                <!-- Гість: кнопка входу -->
                <Button
                    Text="Увійти"
                    Style="{StaticResource PrimaryButton}"
                    HeightRequest="36"
                    Padding="18,0"
                    FontSize="13"
                    Command="{Binding LoginCommand}"
                    IsVisible="{Binding IsGuest}" />

                <!-- Авторизований: смаковий профіль + кружечок, що відкриває профіль -->
                <HorizontalStackLayout
                    Spacing="12"
                    VerticalOptions="Center"
                    IsVisible="{Binding IsAuthenticated}">

                    <Button
                        Text="Смак"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="36"
                        Padding="12,0"
                        FontSize="12"
                        Command="{Binding OpenTasteProfileCommand}"
                        VerticalOptions="Center" />

                    <Border
                        WidthRequest="36"
                        HeightRequest="36"
                        BackgroundColor="#6558D3"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 18">

                        <Grid>
                            <Label
                                Text="{Binding AvatarInitial}"
                                FontSize="16"
                                FontAttributes="Bold"
                                TextColor="White"
                                HorizontalOptions="Center"
                                VerticalOptions="Center" />

                            <Image Source="{Binding AvatarImage}" Aspect="AspectFill" />
                        </Grid>

                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenProfileCommand}" />
                        </Border.GestureRecognizers>
                    </Border>

                </HorizontalStackLayout>

            </Grid>
        </Grid>

        <!-- Основний контент -->
        <ScrollView x:Name="MainScrollView" Grid.Row="1" VerticalScrollBarVisibility="Default" Scrolled="ScrollView_Scrolled">
            <VerticalStackLayout Spacing="12" Padding="12,20,12,20">

                <!-- Пошук -->
                <Border
                    BackgroundColor="#292E3D"
                    StrokeThickness="0"
                    StrokeShape="RoundRectangle 12"
                    Padding="12,0">

                    <SearchBar
                        Placeholder="Пошук фільмів..."
                        PlaceholderColor="#A0A5B5"
                        TextColor="White"
                        BackgroundColor="Transparent"
                        CancelButtonColor="White"
                        FontSize="14"
                        Text="{Binding SearchQuery}"
                        SearchCommand="{Binding SearchCommand}" />

                </Border>

                <!-- Повідомлення про помилки -->
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#FF7777"
                    FontSize="13"
                    IsVisible="{Binding HasError}" />

                <!-- ПОПУЛЯРНЕ ЗАРАЗ -->
                <VerticalStackLayout Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label
                            Text="Популярне зараз"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Grid.Column="1"
                            Text="TMDB"
                            FontSize="12"
                            TextColor="#A0A5B5"
                            VerticalOptions="Center" />
                    </Grid>

                    <ScrollView Orientation="Horizontal" HeightRequest="300" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding PopularMovies}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:MovieListItemDto">
                                    <VerticalStackLayout
                                        WidthRequest="135"
                                        Padding="0,0,0,0"
                                        Spacing="8">

                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.OpenMovieCommand}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <Border
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="#292E3D"
                                            HeightRequest="195"
                                            WidthRequest="135">
                                            <Image
                                                Source="{Binding PosterUrl}"
                                                Aspect="AspectFill"
                                                HeightRequest="195"
                                                WidthRequest="135" />
                                        </Border>

                                        <Label
                                            Text="{Binding Title}"
                                            TextColor="White"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3" />

                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding ReleaseYear}" TextColor="#A0A5B5" FontSize="11" />
                                            <Label Grid.Column="1" Text="{Binding Rating, StringFormat='★ {0:F1}'}" TextColor="#FFC857" FontSize="11" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>

                    <!-- Стани завантаження / помилки для популярних -->
                    <Grid HeightRequest="50" IsVisible="{Binding ShowLoader}">
                        <ActivityIndicator IsRunning="{Binding ShowLoader}" Color="#8B7CFF" HorizontalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>

                <!-- РЕКОМЕНДАЦІЇ -->
                <VerticalStackLayout
                    x:Name="RecommendationsSection"
                    x:DataType="vm:RecommendationsViewModel"
                    Spacing="12"
                    IsVisible="{Binding IsSectionVisible}">

                    <VerticalStackLayout Spacing="2">
                        <Label
                            Text="Рекомендовано для вас"
                            FontSize="20"
                            FontAttributes="Bold"
                            TextColor="White" />
                        <Label
                            Text="{Binding Subtitle}"
                            FontSize="12"
                            TextColor="#A0A5B5"
                            IsVisible="{Binding HasMovies}" />
                    </VerticalStackLayout>

                    <ScrollView Orientation="Horizontal" HeightRequest="300" HorizontalScrollBarVisibility="Never">
                        <HorizontalStackLayout BindableLayout.ItemsSource="{Binding Movies}" Spacing="12">
                            <BindableLayout.ItemTemplate>
                                <DataTemplate x:DataType="dto:MovieListItemDto">
                                    <VerticalStackLayout
                                        WidthRequest="135"
                                        Padding="0,0,10,0"
                                        Spacing="8">

                                        <VerticalStackLayout.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.OpenMovieCommand}"
                                                CommandParameter="{Binding .}" />
                                        </VerticalStackLayout.GestureRecognizers>

                                        <Border
                                            StrokeThickness="0"
                                            StrokeShape="RoundRectangle 10"
                                            BackgroundColor="#292E3D"
                                            HeightRequest="195"
                                            WidthRequest="135">
                                            <Image
                                                Source="{Binding PosterUrl}"
                                                Aspect="AspectFill"
                                                HeightRequest="195"
                                                WidthRequest="135" />
                                        </Border>

                                        <Label
                                            Text="{Binding Title}"
                                            TextColor="White"
                                            FontSize="13"
                                            FontAttributes="Bold"
                                            LineBreakMode="TailTruncation"
                                            MaxLines="3" />

                                        <Grid ColumnDefinitions="*, Auto">
                                            <Label Text="{Binding ReleaseYear}" TextColor="#A0A5B5" FontSize="11" />
                                            <Label Grid.Column="1" Text="{Binding Rating, StringFormat='★ {0:F1}'}" TextColor="#FFC857" FontSize="11" />
                                        </Grid>
                                    </VerticalStackLayout>
                                </DataTemplate>
                            </BindableLayout.ItemTemplate>
                        </HorizontalStackLayout>
                    </ScrollView>
                </VerticalStackLayout>

                <!--КАТАЛОГ ФІЛЬМІВ -->
                <VerticalStackLayout Spacing="12">
                    <Label
                        Text="Каталог фільмів"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="White" />

                    <!-- Фільтри -->
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Border BackgroundColor="#292E3D" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,0">
                            <Picker
                                Title="Усі жанри"
                                ItemsSource="{Binding GenreOptions}"
                                SelectedItem="{Binding SelectedGenre}"
                                TextColor="White"
                                TitleColor="#A0A5B5"
                                FontSize="12" />
                        </Border>

                        <Border Grid.Column="1" BackgroundColor="#292E3D" StrokeThickness="0" StrokeShape="RoundRectangle 10" Padding="8,0">
                            <Picker
                                Title="Сортування"
                                ItemsSource="{Binding SortOptions}"
                                SelectedItem="{Binding SelectedSort}"
                                TextColor="White"
                                TitleColor="#A0A5B5"
                                FontSize="12" />
                        </Border>
                    </Grid>

                    <Button
                        Text="Застосувати фільтри"
                        Command="{Binding ApplyFiltersCommand}"
                        BackgroundColor="#6558D3"
                        TextColor="White"
                        CornerRadius="10"
                        HeightRequest="45"
                        FontAttributes="Bold" />

                    <VerticalStackLayout IsVisible="{Binding IsEmpty}" Padding="20" Spacing="8">
                        <Label
                            Text="Фільмів не знайдено"
                            TextColor="White"
                            FontSize="17"
                            FontAttributes="Bold"
                            HorizontalTextAlignment="Center" />
                    </VerticalStackLayout>
                </VerticalStackLayout>

                <!-- Сітка каталогу фільмів із підтримкою нескінченного скролу -->
                <CollectionView
                    ItemsSource="{Binding Movies}"
                    SelectionMode="None"
                    ItemsLayout="VerticalGrid, 5"
                    SizeChanged="MoviesCollection_SizeChanged">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="dto:MovieListItemDto">
                            <VerticalStackLayout
                                Padding="5"
                                Spacing="7"
                                Margin="0,0,0,15">

                                <VerticalStackLayout.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference MainPageRoot}, Path=BindingContext.OpenMovieCommand}"
                                        CommandParameter="{Binding .}" />
                                </VerticalStackLayout.GestureRecognizers>

                                <!-- Використовуємо пропорційні розміри (Aspect Fill), щоб елементи ідеально адаптувались під шир/кол екрана телефонів -->
                                <Border
                                    BackgroundColor="#292E3D"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 10"
                                    HeightRequest="380"
                                    WidthRequest="280">
                                    <Image
                                        Source="{Binding PosterUrl}"
                                        Aspect="AspectFill"
                                        HeightRequest="380"
                                        WidthRequest="280" />
                                </Border>

                                <Label
                                    Text="{Binding Title}"
                                    TextColor="White"
                                    FontSize="14"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />

                                <Grid ColumnDefinitions="*,Auto">
                                    <Label Text="{Binding ReleaseYear}" TextColor="#A0A5B5" FontSize="12" />
                                    <Label Grid.Column="1" Text="{Binding Rating, StringFormat='★ {0:F1}'}" TextColor="#FFC857" FontSize="12" />
                                </Grid>
                            </VerticalStackLayout>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <!-- Футер з індикатором завантаження наступної сторінки -->
                    <CollectionView.Footer>
                        <VerticalStackLayout Padding="15" Spacing="10" IsVisible="{Binding IsLoading}">
                            <ActivityIndicator IsRunning="{Binding IsLoading}" Color="#8B7CFF" />
                            <Label Text="Завантаження..." TextColor="#A0A5B5" HorizontalOptions="Center" />
                        </VerticalStackLayout>
                    </CollectionView.Footer>
                </CollectionView>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>