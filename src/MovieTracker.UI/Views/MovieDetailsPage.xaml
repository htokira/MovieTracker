<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieTracker.UI.Views.MovieDetailsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:dto="clr-namespace:MovieTracker.Core.Dtos;assembly=MovieTracker.Core"
    Title="Інформація про фільм"
    BackgroundColor="#171923"
    Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*">

        <Grid
            Grid.Row="0"
            Padding="15"
            ColumnDefinitions="Auto,*,Auto"
            BackgroundColor="#202331">

            <Button
                Text="‹ Назад"
                Clicked="OnBackClicked"
                BackgroundColor="Transparent"
                TextColor="White"
                FontSize="14"
                Padding="5,0"
                VerticalOptions="Center" />

            <Label
                Grid.Column="1"
                Text="Movie Tracker"
                FontSize="22"
                FontAttributes="Bold"
                TextColor="White"
                HorizontalOptions="Center"
                VerticalOptions="Center" />

            <ImageButton
                Grid.Column="2"
                Source="Resources/Images/user.png"
                WidthRequest="32"
                HeightRequest="32"
                BackgroundColor="Transparent"
                Aspect="AspectFit"
                VerticalOptions="Center" />

        </Grid>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="20" Padding="20">

                <!-- Основна інформація -->
                <Grid ColumnDefinitions="140,*" ColumnSpacing="18">

                    <Border
                        Grid.Column="0"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 10"
                        HeightRequest="210"
                        WidthRequest="140"
                        BackgroundColor="#292E3D">

                        <Image
                            Source="{Binding Movie.PosterUrl}"
                            Aspect="AspectFill" />

                    </Border>

                    <VerticalStackLayout
                        Grid.Column="1"
                        Spacing="10"
                        VerticalOptions="Center">

                        <Label
                            Text="{Binding Movie.Title}"
                            TextColor="White"
                            FontSize="22"
                            FontAttributes="Bold" />

                        <Label
                            Text="{Binding Movie.ReleaseYear}"
                            TextColor="#A0A5B5"
                            FontSize="15" />

                        <Label
                            Text="{Binding Movie.Rating, StringFormat='★ {0:F1}'}"
                            TextColor="#FFC857"
                            FontSize="17"
                            FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Grid>

                <!-- Жанри -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Жанри"
                        TextColor="White"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding Movie.Genres}"
                        Wrap="Wrap"
                        Direction="Row">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:GenreDto">

                                <Border
                                    BackgroundColor="#292E3D"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 15"
                                    Padding="12,6"
                                    Margin="0,0,8,8">

                                    <Label
                                        Text="{Binding Name}"
                                        TextColor="#B8B1FF"
                                        FontSize="12" />

                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                </VerticalStackLayout>

                <!-- Опис -->
                <VerticalStackLayout Spacing="10">

                    <Label
                        Text="Опис фільму"
                        TextColor="White"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <Label
                        Text="{Binding Movie.Description}"
                        TextColor="#C5C8D3"
                        FontSize="14"
                        LineBreakMode="WordWrap" />

                </VerticalStackLayout>

                <!-- Акторський склад -->
                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Акторський склад"
                        TextColor="White"
                        FontSize="19"
                        FontAttributes="Bold" />

                    <FlexLayout
                        BindableLayout.ItemsSource="{Binding Movie.MoviePersons}"
                        Direction="Row"
                        Wrap="Wrap"
                        JustifyContent="Start"
                        AlignItems="Start">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:MoviePersonDto">

                                <VerticalStackLayout
                                    WidthRequest="105"
                                    Margin="0,0,12,15"
                                    Spacing="6">

                                    <Border
                                        WidthRequest="55"
                                        HeightRequest="65"
                                        StrokeThickness="0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#292E3D">

                                        <Image
                                            Source="{Binding PhotoUrl}"
                                            Aspect="AspectFill" />

                                    </Border>

                                    <Label
                                        Text="{Binding FullName}"
                                        TextColor="White"
                                        FontSize="12"
                                        FontAttributes="Bold"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />

                                    <Label
                                        Text="{Binding Role}"
                                        TextColor="#A0A5B5"
                                        FontSize="11"
                                        MaxLines="2"
                                        LineBreakMode="TailTruncation" />

                                </VerticalStackLayout>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </FlexLayout>

                </VerticalStackLayout>

                <!-- Відгуки -->
                <VerticalStackLayout Spacing="15">

                    <Grid ColumnDefinitions="*,Auto">

                        <Label
                            Text="Відгуки користувачів"
                            TextColor="White"
                            FontSize="19"
                            FontAttributes="Bold" />

                        <Label
                            Grid.Column="1"
                            Text="{Binding Reviews.TotalReviews, StringFormat='Всього: {0}'}"
                            TextColor="#A0A5B5"
                            FontSize="12"
                            VerticalOptions="Center" />

                    </Grid>

                    <HorizontalStackLayout
                        Spacing="8"
                        IsVisible ="{Binding HasReviews}">

                        <Label
                            Text="★"
                            TextColor="#FFC857"
                            FontSize="22" />

                        <Label
                            Text="{Binding Reviews.AverageRating, StringFormat='{0:F1} / 10'}"
                            TextColor="White"
                            FontSize="18"
                            FontAttributes="Bold" />

                    </HorizontalStackLayout>

                    <ActivityIndicator
                        IsRunning="{Binding IsLoadingReviews}"
                        IsVisible="{Binding IsLoadingReviews}"
                        Color="#8B7CFF" />

                    <Label
                        Text="Відгуків про цей фільм поки немає."
                        TextColor="#A0A5B5"
                        FontSize="14"
                        IsVisible="{Binding HasNoReviews}" />

                    <VerticalStackLayout
                        BindableLayout.ItemsSource="{Binding Reviews.Items}"
                        Spacing="12"
                        IsVisible="{Binding HasReviews}">

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="dto:ReviewResponse">
                                <Border
                                    BackgroundColor="#202331"
                                    StrokeThickness="0"
                                    StrokeShape="RoundRectangle 12"
                                    Padding="15">

                                    <VerticalStackLayout Spacing="8">

                                        <Grid ColumnDefinitions="*,Auto">

                                            <Label
                                                Text="{Binding AuthorName}"
                                                TextColor="White"
                                                FontSize="14"
                                                FontAttributes="Bold" />

                                            <Label
                                                Grid.Column="1"
                                                Text="{Binding Rating, StringFormat='★ {0}/10'}"
                                                TextColor="#FFC857"
                                                FontSize="13"
                                                FontAttributes="Bold" />

                                        </Grid>

                                        <Label
                                            Text="{Binding Text}"
                                            TextColor="#C5C8D3"
                                            FontSize="13"
                                            LineBreakMode="WordWrap" />

                                        <Label
                                            Text="{Binding UpdatedAt, StringFormat='Оновлено: {0:dd.MM.yyyy}'}"
                                            TextColor="#777E91"
                                            FontSize="11" />
                                            
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>

                <!-- Помилки -->
                <Label
                    Text="{Binding ErrorMessage}"
                    TextColor="#FF7777"
                    FontSize="14"
                    IsVisible="{Binding HasError}" />

            </VerticalStackLayout>
        </ScrollView>

        <!-- Завантаження -->
        <Grid
            BackgroundColor="#CC171923"
            IsVisible="{Binding IsLoading}">

            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                Color="#8B7CFF"
                WidthRequest="50"
                HeightRequest="50"
                VerticalOptions="Center"
                HorizontalOptions="Center" />

        </Grid>

    </Grid>

</ContentPage>