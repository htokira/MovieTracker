<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieTracker.UI.Views.NotificationsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MovieTracker.UI.ViewModels"
    xmlns:models="clr-namespace:MovieTracker.UI.Models"
    x:DataType="vm:NotificationsViewModel"
    Title="Сповіщення"
    BackgroundColor="#171923"
    Shell.BackgroundColor="#202331"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    SizeChanged="OnPageSizeChanged">

    <Grid
        x:Name="Root"
        RowDefinitions="Auto,Auto,*"
        RowSpacing="12"
        Padding="0,20,0,0"
        HorizontalOptions="Center">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <Label
                Text="← Назад"
                TextColor="#A0A5B5"
                FontSize="16"
                FontAttributes="Bold"
                VerticalOptions="Center">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding GoBackCommand}" />
                </Label.GestureRecognizers>
            </Label>

            <Button
                Grid.Column="1"
                Text="Прочитати всі"
                Style="{StaticResource SecondaryButton}"
                HeightRequest="36"
                Padding="16,0"
                FontSize="13"
                Command="{Binding MarkAllReadCommand}"
                IsEnabled="{Binding IsNotBusy}" />
        </Grid>

        <VerticalStackLayout Grid.Row="1">
            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                HorizontalOptions="Center" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#8B7CFF" />
        </VerticalStackLayout>

        <CollectionView
            Grid.Row="2"
            x:Name="NotificationsCollection"
            ItemsSource="{Binding Items}"
            SelectionMode="Single"
            SelectionChanged="OnSelectionChanged">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="8" />
            </CollectionView.ItemsLayout>

            <CollectionView.EmptyView>
                <Label
                    Text="Сповіщень поки немає."
                    TextColor="#A0A5B5"
                    FontSize="14"
                    HorizontalOptions="Center"
                    Margin="0,20,0,0" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:NotificationItem">
                    <Border
                        BackgroundColor="#202331"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="14">

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">

                            <Border
                                Grid.Column="0"
                                WidthRequest="10"
                                HeightRequest="10"
                                BackgroundColor="#8B7CFF"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 5"
                                VerticalOptions="Start"
                                Margin="0,5,0,0"
                                Opacity="0">
                                <Border.Triggers>
                                    <DataTrigger TargetType="Border" Binding="{Binding IsUnread}" Value="True">
                                        <Setter Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </Border.Triggers>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4">
                                <Label
                                    Text="{Binding Text}"
                                    TextColor="White"
                                    FontSize="14" />
                                <Label
                                    Text="{Binding TimeText}"
                                    TextColor="#A0A5B5"
                                    FontSize="12" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>