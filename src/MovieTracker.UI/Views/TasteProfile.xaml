<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MovieTracker.UI.Views.TasteProfilePage"
    Title="Мій смаковий профіль"
    BackgroundColor="#101014">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20">

            <!-- Заголовок -->
            <VerticalStackLayout Spacing="5">
                <Label
                    Text="Твій кінематографічний профіль"
                    FontSize="26"
                    FontAttributes="Bold"
                    TextColor="White"/>

                <Label
                    Text="Дізнайся більше про власні кінематографічні вподобання"
                    FontSize="14"
                    TextColor="#A5A5B0"/>
            </VerticalStackLayout>

            <!-- Завантаження -->
            <ActivityIndicator
                IsRunning="{Binding IsLoading}"
                IsVisible="{Binding IsLoading}"
                Color="#8B5CF6"/>

            <!-- Помилка або відсутність профілю -->
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="#D1D1D8"
                FontSize="15"
                HorizontalTextAlignment="Center"
                Margin="0,20"/>

            <!-- Основний вміст -->
            <VerticalStackLayout
                IsVisible="{Binding HasProfile}"
                Spacing="16">

                <!-- Архетип -->
                <Border
                    BackgroundColor="#1C1B26"
                    Stroke="#393348"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="✦  АРХЕТИП КОРИСТУВАЧА"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#B69CFF"/>

                        <Label
                            Text="{Binding Interpretation.Archetype}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White"/>

                        <Label
                            Text="{Binding Interpretation.ArchetypeDescription}"
                            FontSize="14"
                            TextColor="#C2C0CC"
                            LineBreakMode="WordWrap"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Титул -->
                <Border
                    BackgroundColor="#1C1B26"
                    Stroke="#393348"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="♛  ТИТУЛ ГЛЯДАЧА"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#F5C76B"/>

                        <Label
                            Text="{Binding Interpretation.Title}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White"/>

                        <Label
                            Text="{Binding Interpretation.TitleDescription}"
                            FontSize="14"
                            TextColor="#C2C0CC"
                            LineBreakMode="WordWrap"/>

                        <Label
                            Text="{Binding Profile.ReviewsCount, StringFormat='Кількість оцінених фільмів: {0}'}"
                            FontSize="12"
                            TextColor="#92909D"/>

                    </VerticalStackLayout>
                </Border>

                <!-- Різноманіття -->
                <Border
                    BackgroundColor="#1C1B26"
                    Stroke="#393348"
                    StrokeThickness="1"
                    Padding="18"
                    StrokeShape="RoundRectangle 16">

                    <VerticalStackLayout Spacing="10">

                        <Label
                            Text="✧  РІЗНОМАНІТТЯ СМАКУ"
                            FontSize="12"
                            FontAttributes="Bold"
                            TextColor="#70D6B3"/>

                        <Label
                            Text="{Binding Interpretation.DiversityLabel}"
                            FontSize="23"
                            FontAttributes="Bold"
                            TextColor="White"/>

                        <Label
                            Text="{Binding Interpretation.DiversityDescription}"
                            FontSize="14"
                            TextColor="#C2C0CC"
                            LineBreakMode="WordWrap"/>

                        <Label
                            Text="{Binding Profile.TasteDiversity, StringFormat='Різноманіття: {0:P0}'}"
                            FontSize="12"
                            TextColor="#92909D"/>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>