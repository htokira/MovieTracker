<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="MovieTracker.UI.Views.TrackingListsPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:vm="clr-namespace:MovieTracker.UI.ViewModels"
    xmlns:models="clr-namespace:MovieTracker.UI.Models"
    x:DataType="vm:TrackingListsViewModel"
    Title="Мої списки"
    BackgroundColor="#171923"
    Shell.BackgroundColor="#202331"
    Shell.ForegroundColor="White"
    Shell.TitleColor="White"
    SizeChanged="OnPageSizeChanged">

    <Grid
        x:Name="Root"
        RowDefinitions="Auto,Auto,Auto,*"
        RowSpacing="12"
        Padding="0,20,0,0"
        HorizontalOptions="Center">

        <Label
            Grid.Row="0"
            Text="← Назад"
            TextColor="#A0A5B5"
            FontSize="16"
            FontAttributes="Bold"
            HorizontalOptions="Start">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding GoBackCommand}" />
            </Label.GestureRecognizers>
        </Label>

        <!-- Вкладки -->
        <Grid Grid.Row="1" ColumnDefinitions="*,*" ColumnSpacing="10">
            <Button
                Grid.Column="0"
                Text="Переглянуто"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ShowWatchedCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsWatchedSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#6558D3" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>

            <Button
                Grid.Column="1"
                Text="Заплановано"
                Style="{StaticResource SecondaryButton}"
                Command="{Binding ShowPlannedCommand}">
                <Button.Triggers>
                    <DataTrigger TargetType="Button" Binding="{Binding IsPlannedSelected}" Value="True">
                        <Setter Property="BackgroundColor" Value="#6558D3" />
                    </DataTrigger>
                </Button.Triggers>
            </Button>
        </Grid>

        <!-- Повідомлення -->
        <VerticalStackLayout Grid.Row="2">
            <Label
                Text="{Binding ErrorMessage}"
                Style="{StaticResource ErrorLabel}"
                IsVisible="{Binding HasError}"
                HorizontalOptions="Center" />
            <ActivityIndicator
                IsRunning="{Binding IsBusy}"
                IsVisible="{Binding IsBusy}"
                Color="#8B7CFF" />
            <Label
                Text="{Binding EmptyText}"
                IsVisible="{Binding IsEmpty}"
                TextColor="#A0A5B5"
                FontSize="14"
                HorizontalTextAlignment="Center"
                HorizontalOptions="Center"
                Margin="0,20,0,0" />
        </VerticalStackLayout>

        <!-- Список -->
        <CollectionView
            Grid.Row="3"
            ItemsSource="{Binding Movies}"
            SelectionMode="None">

            <CollectionView.ItemsLayout>
                <LinearItemsLayout Orientation="Vertical" ItemSpacing="10" />
            </CollectionView.ItemsLayout>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:TrackedMovieItem">
                    <Border
                        BackgroundColor="#202331"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 12"
                        Padding="12">

                        <Grid ColumnDefinitions="56,*" ColumnSpacing="12">

                            <Border
                                Grid.Column="0"
                                WidthRequest="56"
                                HeightRequest="80"
                                BackgroundColor="#292E3D"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 8">
                                <Grid>
                                    <Label
                                        Text="🎬"
                                        FontSize="22"
                                        HorizontalOptions="Center"
                                        VerticalOptions="Center" />
                                    <Image Source="{Binding PosterUrl}" Aspect="AspectFill" />
                                </Grid>
                            </Border>

                            <VerticalStackLayout Grid.Column="1" Spacing="4" VerticalOptions="Center">
                                <Label
                                    Text="{Binding Title}"
                                    TextColor="White"
                                    FontSize="16"
                                    FontAttributes="Bold"
                                    LineBreakMode="TailTruncation"
                                    MaxLines="2" />
                                <Label TextColor="#A0A5B5" FontSize="13">
                                    <Label.FormattedText>
                                        <FormattedString>
                                            <Span Text="{Binding YearText}" />
                                            <Span Text="  ·  " />
                                            <Span Text="{Binding UpdatedText}" />
                                        </FormattedString>
                                    </Label.FormattedText>
                                </Label>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>